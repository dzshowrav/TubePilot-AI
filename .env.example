# Optional backend configuration. The default preview needs no credentials.
# Copy to an untracked .env at the repository root for the API workspace scripts.
API_PORT=4000
# Relative DATABASE_PATH values resolve from apps/api; absolute paths are recommended.
# DATABASE_PATH=/absolute/path/to/tubepilot.sqlite
# Exact production frontend origin when behind a reverse proxy:
# APP_ORIGIN=https://studio.your-domain.example

# Live inference is a DEVELOPMENT-ONLY opt-in, blocked when NODE_ENV=production.
# Default generations use labeled templates; no paid provider is called.
AI_ENABLE_LIVE=false
AI_MODEL_VERIFIED=false
HF_TOKEN=
HF_MODEL=
AI_CONTEXT_TOKENS=16384
# Set verified, positive USD prices for the exact model/provider. No pricing is assumed.
AI_INPUT_PRICE_PER_MILLION=
AI_OUTPUT_PRICE_PER_MILLION=
AI_DAILY_BUDGET_USD=2

# Native Expo only: export this into the native CLI environment or its untracked .env.
# Use the HTTPS API/preview ORIGIN, without /api/v1. This is public configuration, not a secret.
# Web always uses relative URLs and ignores this setting.
# EXPO_PUBLIC_API_URL=https://your-api-origin.example

# Read-only YouTube connector. Off by default; enabling it requires all fields below.
# Configure credentials via a secret manager / untracked local env, never through chat or the client.
YOUTUBE_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# APP_ORIGIN must be the exact HTTPS frontend origin. localhost HTTP is allowed only in development.
# GOOGLE_REDIRECT_URI must equal APP_ORIGIN + /api/v1/youtube/oauth/callback.
GOOGLE_REDIRECT_URI=
# Stable AES-256-GCM key: canonical base64 of 32 random bytes. Keep it separate from database backups.
# Generate locally with: openssl rand -base64 32
# Do not rotate by replacing this key while encrypted credentials still exist; migrate/reconnect first.
YOUTUBE_ENCRYPTION_KEY=
# These are TubePilot's own conservative limits, not a claim about remaining Google project quotas.
# Only channels.list, playlistItems.list, videos.list and owner Analytics reports are used.
YOUTUBE_DATA_UNITS_PER_DAY=1000
YOUTUBE_ANALYTICS_REQUESTS_PER_DAY=500
